<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AppMobileChuckNorris.ViewModels"
             x:Class="AppMobileChuckNorris.Views.PotterPage"
             x:DataType="viewmodels:PotterViewModel"
             Title="Harry Potter Characters">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <Image Source="{Binding ImageUrl}"
                   WidthRequest="200"
                   HeightRequest="260"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" />

            <Frame BorderColor="#740001" Padding="20" CornerRadius="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding CharacterName}"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding House, StringFormat='Casa: {0}'}"
                           FontSize="16"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding Actor, StringFormat='Ator: {0}'}"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Sortear Personagem"
                    Command="{Binding FetchCharacterCommand}"
                    BackgroundColor="#740001"
                    TextColor="#EEBA30"
                    CornerRadius="8"
                    Padding="15" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>